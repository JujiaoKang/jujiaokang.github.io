 for(const b of document.querySelectorAll('[data-view]'))b.addEventListener('click',()=>{activateView(b.dataset.view);updateNull();});$('alternative').addEventListener('change',()=>{s.alternative=$('alternative').value;s.tailShown=false;s.pShown=false;updateNull();});$('showTail').addEventListener('click',()=>{s.tailShown=!s.tailShown;if(!s.tailShown)s.pShown=false;updateNull();});$('calcP').addEventListener('click',()=>{s.pShown=true;updateNull();});$('showExamples').addEventListener('click',openExamples);$('closeModal').addEventListener('click',()=>{$('modal').hidden=true;});$('moreRows').addEventListener('click',moreExamples);$('modal').addEventListener('click',e=>{if(e.target===$('modal'))$('modal').hidden=true;});document.addEventListener('keydown',e=>{if(e.key==='Escape')$('modal').hidden=true;});for(const b of document.querySelectorAll('[data-tie]'))b.addEventListener('click',()=>{s.tieMode=b.dataset.tie;updateTie();});$('fullscreen').addEventListener('click',async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch(err){$('fullscreen').textContent='按F11全屏';}});document.addEventListener('fullscreenchange',()=>{$('fullscreen').textContent=document.fullscreenElement?'退出全屏':'全屏展示';});}
attach();setupN(5);resetCountTeaching();resetPair();updateTie();showTab('pairs');
})();
