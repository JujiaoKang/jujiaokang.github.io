 const b=document.createElement('div');b.className='detail-math';b.textContent=math;
 const c=document.createElement('div');c.className='detail-text';c.textContent=description;box.append(a,b,c);return box;
}
function sumExpression(n,ids,dp,maxTerms=12,prefix='a'){
 if(!ids.length)return {formula:'（无满足条件的 D）',value:0,expanded:'0'};
 const values=ids.map(d=>dp[d]);const total=values.reduce((a,b)=>a+b,0);const name=d=>prefix==='m'?`m(${d})`:`a(${n},${d})`;
 if(ids.length<=maxTerms){return {formula:ids.map(name).join(' + '),expanded:values.map(fmt).join(' + '),value:total};}
 return {formula:`${name(ids[0])} + ··· + ${name(ids.at(-1))}`,expanded:`${ids.length} 项相加`,value:total};
}
function renderPDetail(){
 const panel=$('pDetailedPanel'),report=infer();
 if(!s.pShown||!report){panel.hidden=true;return;}
 panel.hidden=false;
 const n=s.n,M=numPairs(n),stat=kendallStats(s.obs),mode=s.alternative;
 const steps=$('pDetailSteps');steps.replaceChildren();
 const kind=mode==='two'?'双侧':mode==='greater'?'右侧':'左侧';
 $('detailSource').textContent=report.src==='exact'?`${kind}精确排列检验`:`${kind}Monte Carlo 模拟估计`;
 const originalPairs=n===5?pairsOf(s.rawX,s.rawY):null;
 const pairNames=pred=>originalPairs.filter(pred).map(p=>String.fromCharCode(65+p.i)+String.fromCharCode(65+p.j)).join('、');
 const rawProof=n===5?`原始 X = (${s.rawX.map(x=>x.toFixed(1)).join(', ')})，原始 Y = (${s.rawY.join(', ')})。协同对：${pairNames(p=>p.c>0)}；不协同对：${pairNames(p=>p.c<0)}。`:'根据观察样本的两两秩次顺序进行比较。';
 steps.append(pStep(1,'从原始数值计算观察统计量',`n = ${n}；N = n(n−1)/2 = ${M}；C = ${stat.c}，D = ${stat.d}；τobs = (${stat.c}−${stat.d})/${M} = ${taufmt(stat.tau)}`,
  `${rawProof}共 ${stat.c} 对协同、${stat.d} 对不协同；每对按 (Xᵢ−Xⱼ)(Yᵢ−Yⱼ) 的正负判断，最后 τₐ=(C−D)/N。`));
 steps.append(pStep(2,'确定零假设与分母',report.src==='exact'?`${n}! = ${fmt(report.total)} 种等可能排列`:`Seed = ${s.seed}；模拟次数 B = ${fmt(report.total)}`,
  report.src==='exact'?'H₀：X 与 Y 独立，无并列秩。固定 X 的排序，所有 Y 的秩次排列等可能。':'H₀ 与精确检验相同，但分母是实际模拟次数，而非 n!。模拟中允许重复抽到同一排列。'));
 const ds=Array.from({length:M+1},(_,i)=>i),tau=d=>1-2*d/M,eps=1e-10;
 let groupA=[],groupB=[],boundary='';
 if(mode==='two'){
  const lim=Math.abs(stat.tau);
  if(lim<eps){groupA=ds.filter(d=>tau(d)<0);groupB=ds.filter(d=>tau(d)>=0);boundary='|τ| ≥ 0：所有排列均属于极端结果。为避免重复，把 τ<0 与 τ≥0 分别计数。';}
  else{groupA=ds.filter(d=>tau(d)<=-lim+eps);groupB=ds.filter(d=>tau(d)>=lim-eps);
   boundary=`τ ≤ −${lim.toFixed(3)} 对应 D ≥ ${Math.min(...groupA)}；τ ≥ +${lim.toFixed(3)} 对应 D ≤ ${Math.max(...groupB)}。`;
  }
 }else if(mode==='greater'){
  groupB=ds.filter(d=>tau(d)>=stat.tau-eps);
  boundary=`τ ≥ ${stat.tau.toFixed(3)} 对应 D ≤ ${Math.max(...groupB)}。`;
 }else{
  groupA=ds.filter(d=>tau(d)<=stat.tau+eps);
  boundary=`τ ≤ ${stat.tau.toFixed(3)} 对应 D ≥ ${Math.min(...groupA)}。`;
 }
 const activeDP=report.cnt;
 const prefix=report.src==='exact'?'a':'m';
 const a=sumExpression(n,groupA,activeDP,12,prefix),b=sumExpression(n,groupB,activeDP,12,prefix),total=a.value+b.value;
 const termA=groupA.length?`左侧：${a.formula} = ${a.expanded} = ${fmt(a.value)}`:'';
 const termB=groupB.length?`右侧：${b.formula} = ${b.expanded} = ${fmt(b.value)}`:'';
 const label=report.src==='exact'?'排列数':'模拟次数';
 const lines=[termA,termB].filter(Boolean).join('；');
 steps.append(pStep(3,`找出至少同样极端的${label}`,boundary,
  `${report.src==='mc'?'其中 m(d) 表示在 Monte Carlo 中抽到逆序对数 D=d 的次数。':''}${lines}。合计 ${fmt(total)} ${report.src==='exact'?'种':'次'}。`));
 const fraction=`${fmt(total)} / ${fmt(report.total)} = ${(total/report.total).toFixed(6)}`;
 steps.append(pStep(4,report.src==='exact'?'计算精确 P 值':'计算 Monte Carlo P 值估计',
  `P${report.src==='mc'?'̂':''} = ${fraction}`,
  report.src==='exact'?'双侧采用两端极端排列数之和除以全部 n! 种排列；单侧只计算指定方向。':'这是从模拟次数估计的尾部概率，存在Monte Carlo随机误差，不等于严格精确概率。'));
 const res=$('pDetailResult');
 const intro=`P 值的定义：在 H₀ 成立的条件下，出现当前观察到的检验统计量或者更极端结果的概率。`;
 res.textContent=`${intro}   ${report.src==='exact'?'精确':'模拟估计'} P ${report.src==='mc'?'≈':'='} ${report.p.toFixed(4)}；${report.p<.05?'α = 0.05 下拒绝 H₀。':'α = 0.05 下不拒绝 H₀。'}`;
}
